# CarMilan Environment Configuration Example
# Copy this file to .env or .env.local to configure Supabase and platform security

# Supabase Project URL (From your Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (Safe to expose in browser)
# DO NOT place service_role secret keys here!
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Administrative Provisioning Secret (Used for CLI / secure backend provisioning of first administrator)
VITE_ADMIN_PROVISIONING_SECRET=your-admin-provisioning-secret-here

# Optional: Default App Name
VITE_APP_NAME=CarMilan

# Note: If Supabase credentials are not configured, CarMilan runs in secure standalone mode
# with client database persistence, salted SHA-256 cryptographic hashing, role-based route guards,
# and verified dealership pending state. Real registration and login are strictly required.

